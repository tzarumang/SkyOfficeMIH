# Copy to .env for `docker compose up`, or paste these into the Portainer
# stack's environment section.
#
# Everything the browser connects to has to be reachable from wherever people
# open the app. Container names do not work here.

# --- what the browser connects to -------------------------------------------
# Behind a reverse proxy with TLS:
#   SERVER_URL=wss://office-api.example.com
#   PEER_HOST=office-peer.example.com
#   PEER_PORT=443
#   PEER_SECURE=true
#
# Straight at a host with no proxy:
#   SERVER_URL=ws://192.168.1.10:2567
#   PEER_HOST=192.168.1.10
#   PEER_PORT=9000
#   PEER_SECURE=false
SERVER_URL=
PEER_HOST=
PEER_PORT=
PEER_PATH=/
PEER_SECURE=

# --- turn relay ---------------------------------------------------------------
# Signalling only introduces two browsers to each other; the call itself then
# goes straight between them. That fails outright - not slowly, never - when
# neither network will accept an unsolicited packet, which is what symmetric
# and carrier-grade NAT do. Most mobile data is behind one. A relay is the only
# way those people get a call at all.
#
# The bundled coturn is opt-in, because it is no use until it has credentials
# and its ports are reachable:
#
#   docker compose --profile turn up
#
# Unlike everything else here it cannot sit behind an HTTP reverse proxy or a
# Cloudflare tunnel - browsers speak to it directly over UDP - so its ports
# have to be open. That means BIND_ADDRESS=0.0.0.0 (or a published host) and
# TURN_EXTERNAL_IP set to the public address peers should send to.
#
#   TURN_URL=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
#   TURN_USERNAME=skyoffice
#   TURN_CREDENTIAL=<a long random string>
#   TURN_EXTERNAL_IP=203.0.113.10
#
# Set TURN_URL alone and no relay is offered: an open one is a relay for
# anybody on the internet, so credentials are not optional.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_REALM=skyoffice
TURN_EXTERNAL_IP=

# --- server ------------------------------------------------------------------
# Comma separated, no trailing slash, e.g. https://office.example.com
ALLOWED_ORIGINS=

# The /colyseus dashboard reads every room's state and can disconnect clients.
# It is only mounted when both of these are set.
COLYSEUS_MONITOR_USER=
COLYSEUS_MONITOR_PASSWORD=

# Where offices with a lifetime are recorded. The compose file backs this with
# a named volume; losing the file closes every office that had a lifetime.
OFFICE_STORE_PATH=/app/data/offices.json

# --- published ports ---------------------------------------------------------
# Which host interface the ports bind to. The default keeps them on loopback,
# reachable only from the host itself - right when something on that host
# forwards them, like a Cloudflare tunnel or a reverse proxy. Nothing on the
# network can reach the containers directly.
#
# Set 0.0.0.0 to expose them to your network instead. Do that only if the host
# is not internet-facing, or the game server and the peerjs broker are open to
# anyone who can route to it.
BIND_ADDRESS=127.0.0.1

CLIENT_PORT=8080
SERVER_PORT=2567
PEER_PUBLIC_PORT=9000
# Plus 49160-49200/udp for the relay itself, which is published whenever the
# turn profile is up.
TURN_PORT=3478

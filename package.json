{
  "name": "skyoffice",
  "version": "1.0.0",
  "description": "Server for SkyOffice",
  "main": "server/lib/server/index.js",
  "scripts": {
    "start": "cd server && ts-node-dev --project tsconfig.server.json --respawn --transpile-only index.ts",
    "build": "tsc --project server/tsconfig.server.json",
    "lint": "eslint .",
    "start:prod": "node server/lib/server/index.js",
    "test": "ts-node --project server/tsconfig.server.json server/test/integration.ts",
    "office:generate": "ts-node --project server/tsconfig.server.json server/office/cli.ts",
    "audit:check": "node scripts/audit.js",
    "audit:update": "node scripts/audit.js --update"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tzarumang/SkyOfficeMIH.git"
  },
  "keywords": [],
  "author": "kevinshen56714",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tzarumang/SkyOfficeMIH/issues"
  },
  "homepage": "https://github.com/tzarumang/SkyOfficeMIH#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "colyseus.js": "^0.16.22",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.11.0",
    "minimist": "^1.2.8",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@colyseus/command": "^0.3.2",
    "@colyseus/core": "0.16.24",
    "@colyseus/monitor": "^0.16.7",
    "@colyseus/schema": "^3.0.76",
    "@colyseus/ws-transport": "^0.16.5",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "bcrypt": "^6.0.0",
    "colyseus": "^0.16.5",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "regenerator-runtime": "^0.14.1"
  }
}
